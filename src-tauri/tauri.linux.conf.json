{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["appimage", "deb", "rpm"],
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/libonnxruntime.so": "libonnxruntime.so"
    },
    "linux": {
      "deb": {
        "depends": [
          "pipewire-bin",
          "wireplumber",
          "wl-clipboard",
          "wtype",
          "playerctl",
          "libnotify-bin"
        ]
      },
      "rpm": {
        "depends": [
          "pipewire-utils",
          "wireplumber",
          "wl-clipboard",
          "wtype",
          "playerctl",
          "libnotify"
        ]
      }
    }
  }
}
